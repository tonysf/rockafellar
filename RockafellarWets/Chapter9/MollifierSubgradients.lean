/-! ### Local Lipschitz bounds -/

omit [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E] in
/-- A function strictly continuous at every point is Lipschitz continuous on every compact
set. -/
theorem exists_lipschitzOnWith_of_forall_strictlyContinuousAt {f : E → ℝ}
    (hf : ∀ y, StrictlyContinuousAt f y) {K : Set E} (hK : IsCompact K) :
    ∃ k : ℝ≥0, LipschitzOnWith k f K := by
  have hll : LocallyLipschitzOn K f := fun y _ ↦ by
    obtain ⟨k, U, hU, hL⟩ := strictlyContinuousAt_iff.1 (hf y)
    exact ⟨k, U, nhdsWithin_le_nhds hU, hL⟩
  exact hll.exists_lipschitzOnWith_of_compact hK

omit [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E] in
theorem continuous_of_forall_strictlyContinuousAt {f : E → ℝ}
    (hf : ∀ y, StrictlyContinuousAt f y) : Continuous f :=
  continuous_iff_continuousAt.2 fun y ↦ by
    obtain ⟨k, U, hU, hL⟩ := strictlyContinuousAt_iff.1 (hf y)
    exact hL.continuousOn.continuousAt hU

omit [MeasurableSpace E] [BorelSpace E] in
/-- The gradient of a function Lipschitz on a neighborhood is bounded by the constant
(the gradient is `0` at points of nondifferentiability). -/
theorem norm_gradient_le_of_lipschitzOnWith {f : E → ℝ} {s : Set E} {k : ℝ≥0}
    (hL : LipschitzOnWith k f s) {y : E} (hs : s ∈ 𝓝 y) : ‖gradient f y‖ ≤ k := by
  rw [gradient, LinearIsometryEquiv.norm_map]
  exact norm_fderiv_le_of_lipschitzOn ℝ hs hL

omit [MeasurableSpace E] [BorelSpace E] in
theorem inner_gradient_eq_fderiv (f : E → ℝ) (y w : E) :
    ⟪gradient f y, w⟫_ℝ = fderiv ℝ f y w := by
  rw [gradient, toDual_symm_apply]

theorem measurable_gradient_of_finiteDimensional (f : E → ℝ) : Measurable (gradient f) :=
  (toDual ℝ E).symm.continuous.measurable.comp (measurable_fderiv ℝ f)

theorem locallyIntegrable_gradient_of_forall_strictlyContinuousAt {f : E → ℝ}
    (hf : ∀ y, StrictlyContinuousAt f y) (μ : Measure E) [IsFiniteMeasureOnCompacts μ] :
    LocallyIntegrable (gradient f) μ := by
  intro y
  obtain ⟨k, U, hU, hL⟩ := strictlyContinuousAt_iff.1 (hf y)
  obtain ⟨r, hr, hrU⟩ := Metric.mem_nhds_iff.1 hU
  refine ⟨ball y r, ball_mem_nhds y hr, ?_⟩
  refine Measure.integrableOn_of_bounded (M := k) measure_ball_lt_top.ne
    (measurable_gradient_of_finiteDimensional f).aestronglyMeasurable ?_
  filter_upwards [ae_restrict_mem measurableSet_ball] with z hz
  exact norm_gradient_le_of_lipschitzOnWith hL (mem_of_superset (isOpen_ball.mem_nhds hz) hrU)

/-! ### Averages against a bounded kernel -/

theorem integrable_kernel_smul {μ : Measure E} [IsFiniteMeasureOnCompacts μ] {ψ : E → ℝ}
    (hψm : Measurable ψ) {M R C : ℝ} (hψM : ∀ z, |ψ z| ≤ M) (hψR : support ψ ⊆ closedBall 0 R)
    {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V] {φ : E → V}
    (hφ : AEStronglyMeasurable φ μ) (hφC : ∀ t ∈ closedBall (0 : E) R, ‖φ t‖ ≤ C) :
    Integrable (fun t ↦ ψ t • φ t) μ := by
  have hfin : μ (closedBall (0 : E) R) ≠ ⊤ := (isCompact_closedBall 0 R).measure_lt_top.ne
  have hg : Integrable ((closedBall (0 : E) R).indicator (fun _ ↦ M * C)) μ :=
    (integrable_indicator_iff measurableSet_closedBall).2 (integrableOn_const hfin)
  refine hg.mono' (hψm.aestronglyMeasurable.smul hφ) (Eventually.of_forall fun t ↦ ?_)
  by_cases ht : t ∈ closedBall (0 : E) R
  · rw [indicator_of_mem ht, norm_smul, Real.norm_eq_abs]
    exact mul_le_mul (hψM t) (hφC t ht) (norm_nonneg _) ((abs_nonneg _).trans (hψM t))
  · have h0 : ψ t = 0 := by
      by_contra h
      exact ht (hψR h)
    simp [h0, indicator_of_notMem ht]

theorem integrable_kernel_mul_comp_sub {μ : Measure E} [IsFiniteMeasureOnCompacts μ]
    {ψ : E → ℝ} (hψm : Measurable ψ) {M R : ℝ} (hψM : ∀ z, |ψ z| ≤ M)
    (hψR : support ψ ⊆ closedBall 0 R) {f : E → ℝ} (hfc : Continuous f) (z : E) :
    Integrable (fun t ↦ ψ t * f (z - t)) μ := by
  have hc : Continuous fun t ↦ f (z - t) := hfc.comp (continuous_const.sub continuous_id)
  obtain ⟨B, hB⟩ := (isCompact_closedBall (0 : E) R).exists_bound_of_continuousOn hc.continuousOn
  have h := integrable_kernel_smul hψm hψM hψR (μ := μ) hc.aestronglyMeasurable hB
  simpa only [smul_eq_mul] using h

/-- **Formula 9(38)**: the average of a function that is strictly continuous everywhere
against a bounded measurable kernel with bounded support is differentiable, with
`∇f^ν(x) = ∫ ψ(t) ∇f(x - t) dt`. -/
theorem hasGradientAt_mollifiedAverage {μ : Measure E} [μ.IsAddHaarMeasure] {ψ : E → ℝ}
    (hψm : Measurable ψ) (hψ0 : ∀ z, 0 ≤ ψ z) {M R : ℝ} (hψM : ∀ z, ψ z ≤ M)
    (hψR : support ψ ⊆ closedBall 0 R) {f : E → ℝ} (hf : ∀ y, StrictlyContinuousAt f y)
    (x : E) :
    HasGradientAt (mollifiedAverage μ ψ f) (∫ t, ψ t • gradient f (x - t) ∂μ) x := by
  set R' := max R 0 with hR'
  have hR'0 : 0 ≤ R' := le_max_right _ _
  have hψR' : support ψ ⊆ closedBall 0 R' :=
    hψR.trans (closedBall_subset_closedBall (le_max_left _ _))
  have hψA : ∀ z, |ψ z| ≤ M := fun z ↦ by rw [abs_of_nonneg (hψ0 z)]; exact hψM z
  have hfc := continuous_of_forall_strictlyContinuousAt hf
  obtain ⟨k, hk⟩ := exists_lipschitzOnWith_of_forall_strictlyContinuousAt hf
    (isCompact_closedBall x (R' + 2))
  have hmem : ∀ x' ∈ ball x 1, ∀ t ∈ closedBall (0 : E) R', x' - t ∈ closedBall x (R' + 2) := by
    intro x' hx' t ht
    rw [mem_ball, dist_eq_norm] at hx'
    rw [mem_closedBall_zero_iff] at ht
    rw [mem_closedBall, dist_eq_norm]
    calc ‖x' - t - x‖ = ‖(x' - x) - t‖ := by congr 1; abel
      _ ≤ ‖x' - x‖ + ‖t‖ := norm_sub_le _ _
      _ ≤ R' + 2 := by linarith
  have hxmem : ∀ t ∈ closedBall (0 : E) R', x - t ∈ closedBall x (R' + 2) :=
    fun t ht ↦ hmem x (mem_ball_self one_pos) t ht
  have hnhds : ∀ t ∈ closedBall (0 : E) R', closedBall x (R' + 2) ∈ 𝓝 (x - t) := by
    intro t ht
    refine mem_of_superset (isOpen_ball.mem_nhds ?_) ball_subset_closedBall
    rw [mem_closedBall_zero_iff] at ht
    rw [mem_ball, dist_eq_norm, sub_sub_cancel_left, norm_neg]
    linarith
  have hgradbound : ∀ t ∈ closedBall (0 : E) R', ‖gradient f (x - t)‖ ≤ k :=
    fun t ht ↦ norm_gradient_le_of_lipschitzOnWith hk (hnhds t ht)
  have hgm : Measurable (gradient f) := measurable_gradient_of_finiteDimensional f
  have hgm' : Measurable fun t ↦ gradient f (x - t) := hgm.comp (measurable_const.sub measurable_id)
  have hint_f : ∀ z, Integrable (fun t ↦ ψ t * f (z - t)) μ :=
    integrable_kernel_mul_comp_sub hψm hψA hψR' hfc
  have hint_g : Integrable (fun t ↦ ψ t • gradient f (x - t)) μ :=
    integrable_kernel_smul hψm hψA hψR' hgm'.aestronglyMeasurable hgradbound
  have hψint : Integrable ψ μ := by
    have h := integrable_kernel_smul (μ := μ) hψm hψA hψR' (φ := fun _ ↦ (1 : ℝ)) (C := 1)
      aestronglyMeasurable_const (fun _ _ ↦ by simp)
    simpa only [smul_eq_mul, mul_one] using h
  set g₀ := ∫ t, ψ t • gradient f (x - t) ∂μ with hg₀
  have hid : ∀ x', mollifiedAverage μ ψ f x' - mollifiedAverage μ ψ f x - ⟪g₀, x' - x⟫_ℝ =
      ∫ t, ψ t * (f (x' - t) - f (x - t) - ⟪gradient f (x - t), x' - x⟫_ℝ) ∂μ := by
    intro x'
    have hi3 : Integrable (fun t ↦ ψ t * ⟪gradient f (x - t), x' - x⟫_ℝ) μ := by
      have h := integrable_kernel_smul (μ := μ) hψm hψA hψR' (C := k * ‖x' - x‖)
        ((hgm'.inner measurable_const).aestronglyMeasurable)
        (fun t ht ↦ by
          rw [Real.norm_eq_abs]
          exact (abs_real_inner_le_norm _ _).trans
            (mul_le_mul_of_nonneg_right (hgradbound t ht) (norm_nonneg _)))
      simpa only [smul_eq_mul] using h
    have h1 : ⟪g₀, x' - x⟫_ℝ = ∫ t, ψ t * ⟪gradient f (x - t), x' - x⟫_ℝ ∂μ := by
      rw [real_inner_comm, hg₀, ← integral_inner hint_g]
      congr 1
      ext t
      rw [real_inner_comm, real_inner_smul_left]
    have hsub : Integrable (fun t ↦ ψ t * f (x' - t) - ψ t * f (x - t)) μ :=
      (hint_f x').sub (hint_f x)
    rw [h1, mollifiedAverage, mollifiedAverage, ← integral_sub (hint_f x') (hint_f x),
      ← integral_sub hsub hi3]
    congr 1
    ext t
    ring
  rw [hasGradientAt_iff_hasFDerivAt, hasFDerivAt_iff_tendsto]
  set Φ : E → E → ℝ := fun x' t ↦
    ψ t * (‖x' - x‖⁻¹ * |f (x' - t) - f (x - t) - ⟪gradient f (x - t), x' - x⟫_ℝ|) with hΦ
  have hlimΦ : Tendsto (fun x' ↦ ∫ t, Φ x' t ∂μ) (𝓝 x) (𝓝 0) := by
    have hfm : Measurable f := hfc.measurable
    have h := tendsto_integral_filter_of_dominated_convergence (μ := μ) (l := 𝓝 x) (F := Φ)
      (f := fun _ ↦ (0 : ℝ)) (fun t ↦ ψ t * (2 * k)) ?meas ?bound (hψint.mul_const _) ?lim
    · simpa using h
    case meas =>
      refine Eventually.of_forall fun x' ↦ Measurable.aestronglyMeasurable ?_
      have h1 : Measurable fun t ↦ f (x' - t) := hfm.comp (measurable_const.sub measurable_id)
      have h2 : Measurable fun t ↦ f (x - t) := hfm.comp (measurable_const.sub measurable_id)
      have h3 : Measurable fun t ↦ f (x' - t) - f (x - t) - ⟪gradient f (x - t), x' - x⟫_ℝ :=
        (h1.sub h2).sub (hgm'.inner measurable_const)
      exact hψm.mul (measurable_const.mul (continuous_abs.measurable.comp h3))
    case bound =>
      filter_upwards [ball_mem_nhds x one_pos] with x' hx'
      refine Eventually.of_forall fun t ↦ ?_
      by_cases ht : t ∈ closedBall (0 : E) R'
      · have hnn : 0 ≤ Φ x' t := by
          simp only [hΦ]
          exact mul_nonneg (hψ0 t) (mul_nonneg (inv_nonneg.2 (norm_nonneg _)) (abs_nonneg _))
        rw [Real.norm_eq_abs, abs_of_nonneg hnn]
        refine mul_le_mul_of_nonneg_left ?_ (hψ0 t)
        rcases eq_or_ne x' x with rfl | hne
        · simp only [sub_self, norm_zero, inv_zero, zero_mul]
          positivity
        · have hpos : 0 < ‖x' - x‖ := norm_pos_iff.2 (sub_ne_zero.2 hne)
          rw [inv_mul_le_iff₀ hpos]
          have h1 : |f (x' - t) - f (x - t)| ≤ k * ‖x' - x‖ := by
            have h := hk.dist_le_mul (x' - t) (hmem x' hx' t ht) (x - t) (hxmem t ht)
            rwa [Real.dist_eq, dist_eq_norm, sub_sub_sub_cancel_right] at h
          have h2 : |⟪gradient f (x - t), x' - x⟫_ℝ| ≤ k * ‖x' - x‖ :=
            (abs_real_inner_le_norm _ _).trans
              (mul_le_mul_of_nonneg_right (hgradbound t ht) (norm_nonneg _))
          calc |f (x' - t) - f (x - t) - ⟪gradient f (x - t), x' - x⟫_ℝ|
              ≤ |f (x' - t) - f (x - t)| + |⟪gradient f (x - t), x' - x⟫_ℝ| := abs_sub _ _
            _ ≤ k * ‖x' - x‖ + k * ‖x' - x‖ := add_le_add h1 h2
            _ = ‖x' - x‖ * (2 * k) := by ring
      · have h0 : ψ t = 0 := by
          by_contra h
          exact ht (hψR' h)
        simp [hΦ, h0]
    case lim =>
      have hae : ∀ᵐ y ∂μ, DifferentiableAt ℝ f y :=
        (ae_differentiableAt_of_strictlyContinuousAt f μ).mono fun y hy ↦ hy (hf y)
      filter_upwards [(quasiMeasurePreserving_sub_left μ x).ae hae] with t ht
      have h1 := hasFDerivAt_iff_tendsto.1 ht.hasFDerivAt
      have h2 := h1.comp ((continuous_sub_right t).tendsto x)
      have h3 : Tendsto (fun x' ↦ ‖x' - x‖⁻¹ *
          |f (x' - t) - f (x - t) - ⟪gradient f (x - t), x' - x⟫_ℝ|) (𝓝 x) (𝓝 0) := by
        refine h2.congr fun x' ↦ ?_
        simp only [Function.comp_apply, sub_sub_sub_cancel_right, Real.norm_eq_abs,
          inner_gradient_eq_fderiv]
      simpa using h3.const_mul (ψ t)
  refine squeeze_zero' (Eventually.of_forall fun x' ↦ by positivity) ?_ hlimΦ
  refine Eventually.of_forall fun x' ↦ ?_
  rw [toDual_apply_apply, hid x', Real.norm_eq_abs]
  calc ‖x' - x‖⁻¹ * |∫ t, ψ t * (f (x' - t) - f (x - t) - ⟪gradient f (x - t), x' - x⟫_ℝ) ∂μ|
      ≤ ‖x' - x‖⁻¹ *
          ∫ t, |ψ t * (f (x' - t) - f (x - t) - ⟪gradient f (x - t), x' - x⟫_ℝ)| ∂μ :=
        mul_le_mul_of_nonneg_left abs_integral_le_integral_abs (inv_nonneg.2 (norm_nonneg _))
    _ = ∫ t, Φ x' t ∂μ := by
        rw [← integral_const_mul]
        congr 1
        ext t
        rw [hΦ, abs_mul, abs_of_nonneg (hψ0 t)]
        ring

/-- **Formula 9(39)**: increments of an average are averages of increments. -/
theorem mollifiedAverage_add_smul_sub {μ : Measure E} [IsFiniteMeasureOnCompacts μ]
    {ψ : E → ℝ} (hψm : Measurable ψ) {M R : ℝ} (hψM : ∀ z, |ψ z| ≤ M)
    (hψR : support ψ ⊆ closedBall 0 R) {f : E → ℝ} (hfc : Continuous f) (y w : E) (τ : ℝ) :
    mollifiedAverage μ ψ f (y + τ • w) - mollifiedAverage μ ψ f y =
      ∫ t, ψ t * (f (y - t + τ • w) - f (y - t)) ∂μ := by
  rw [mollifiedAverage, mollifiedAverage,
    ← integral_sub (integrable_kernel_mul_comp_sub hψm hψM hψR hfc _)
      (integrable_kernel_mul_comp_sub hψm hψM hψR hfc _)]
  congr 1
  ext t
  rw [add_sub_right_comm, mul_sub]

/-- With continuous kernels the averages are continuously differentiable. -/
theorem contDiff_mollifiedAverage {μ : Measure E} [μ.IsAddHaarMeasure] {ψ : E → ℝ}
    (hψc : Continuous ψ) (hψ0 : ∀ z, 0 ≤ ψ z) {M R : ℝ} (hψM : ∀ z, ψ z ≤ M)
    (hψR : support ψ ⊆ closedBall 0 R) {f : E → ℝ} (hf : ∀ y, StrictlyContinuousAt f y) :
    ContDiff ℝ 1 (mollifiedAverage μ ψ f) := by
  have hgrad := hasGradientAt_mollifiedAverage (μ := μ) hψc.measurable hψ0 hψM hψR hf
  rw [contDiff_one_iff_fderiv]
  refine ⟨fun x ↦ (hgrad x).differentiableAt, ?_⟩
  have hfd : fderiv ℝ (mollifiedAverage μ ψ f) =
      fun x ↦ toDual ℝ E (∫ t, ψ t • gradient f (x - t) ∂μ) :=
    funext fun x ↦ (hasGradientAt_iff_hasFDerivAt.1 (hgrad x)).fderiv
  rw [hfd]
  have hcs : HasCompactSupport ψ := HasCompactSupport.intro (isCompact_closedBall 0 R)
    fun z hz ↦ notMem_support.1 fun h ↦ hz (hψR h)
  have hcont : Continuous (ψ ⋆[ContinuousLinearMap.lsmul ℝ ℝ, μ] gradient f) :=
    hcs.continuous_convolution_left _ hψc
      (locallyIntegrable_gradient_of_forall_strictlyContinuousAt hf μ)
  exact (toDual ℝ E).continuous.comp hcont

/-! ### The gradient limits `G(x̄)` -/

/-- The set `G(x̄)` of Theorem 9.67: the vectors `v` for which there are an infinite index set
`N` and points `x^ν → x̄` (`ν ∈ N`) with `∇f^ν(x^ν) → v`, encoded as the slice at `x̄` of the
outer limit of the graphs of the averaged gradients (see `mem_mollifierGradientLimits_iff`). -/
def mollifierGradientLimits (μ : Measure E) (ψ : ℕ → E → ℝ) (f : E → ℝ) (x : E) : Set E :=
  {v | (x, v) ∈ outerSetLimit
    (fun n ↦ {p : E × E | p.2 = gradient (mollifiedAverage μ (ψ n) f) p.1})}

omit [BorelSpace E] in
/-- The defining description of `G(x̄)` in the book. -/
theorem mem_mollifierGradientLimits_iff {μ : Measure E} {ψ : ℕ → E → ℝ} {f : E → ℝ}
    {x v : E} :
    v ∈ mollifierGradientLimits μ ψ f x ↔ ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∃ z : ℕ → E,
      Tendsto z atTop (𝓝 x) ∧
        Tendsto (fun k ↦ gradient (mollifiedAverage μ (ψ (φ k)) f) (z k)) atTop (𝓝 v) := by
  unfold mollifierGradientLimits
  rw [mem_setOf_eq, mem_outerSetLimit_iff_exists_subsequence]
  constructor
  · rintro ⟨φ, y, hφ, hy, hlim⟩
    refine ⟨φ, hφ, fun k ↦ (y k).1, (continuous_fst.tendsto _).comp hlim, ?_⟩
    refine ((continuous_snd.tendsto _).comp hlim).congr fun k ↦ ?_
    exact hy k
  · rintro ⟨φ, hφ, z, hz, hv⟩
    exact ⟨φ, fun k ↦ (z k, gradient (mollifiedAverage μ (ψ (φ k)) f) (z k)), hφ,
      fun k ↦ rfl, hz.prodMk_nhds hv⟩

omit [BorelSpace E] in
theorem isClosed_graph_mollifierGradientLimits (μ : Measure E) (ψ : ℕ → E → ℝ) (f : E → ℝ) :
    IsClosed {p : E × E | p.2 ∈ mollifierGradientLimits μ ψ f p.1} :=
  isClosed_outerSetLimit _

variable {μ : Measure E} {ψ : ℕ → E → ℝ} {f : E → ℝ}

/-- Formula 9(38) along a bounded mollifier sequence. -/
theorem IsBoundedMollifierSequence.hasGradientAt [μ.IsAddHaarMeasure]
    (hψ : IsBoundedMollifierSequence ψ μ) (hf : ∀ y, StrictlyContinuousAt f y) (n : ℕ) (x : E) :
    HasGradientAt (mollifiedAverage μ (ψ n) f) (∫ t, ψ n t • gradient f (x - t) ∂μ) x := by
  obtain ⟨M, hM⟩ := hψ.bounded n
  obtain ⟨R, hR⟩ := (isBounded_iff_subset_closedBall (0 : E)).mp hψ.bounded_supports
  exact hasGradientAt_mollifiedAverage (hψ.measurable n) (hψ.nonneg n) hM
    (fun z hz ↦ hR (mem_iUnion.2 ⟨n, hz⟩)) hf x

theorem IsBoundedMollifierSequence.mollifiedAverage_add_smul_sub [IsFiniteMeasureOnCompacts μ]
    (hψ : IsBoundedMollifierSequence ψ μ) (n : ℕ) {f : E → ℝ} (hfc : Continuous f)
    (y w : E) (τ : ℝ) :
    mollifiedAverage μ (ψ n) f (y + τ • w) - mollifiedAverage μ (ψ n) f y =
      ∫ t, ψ n t * (f (y - t + τ • w) - f (y - t)) ∂μ := by
  obtain ⟨M, hM⟩ := hψ.bounded n
  obtain ⟨R, hR⟩ := (isBounded_iff_subset_closedBall (0 : E)).mp hψ.bounded_supports
  exact RW.mollifiedAverage_add_smul_sub (hψ.measurable n)
    (fun z ↦ by rw [abs_of_nonneg (hψ.nonneg n z)]; exact hM z)
    (fun z hz ↦ hR (mem_iUnion.2 ⟨n, hz⟩)) hfc y w τ

/-- Averaged directional derivatives near `x̄` are eventually bounded by any number exceeding
the Clarke derivative `d̂f(x̄)(w)`. -/
theorem IsBoundedMollifierSequence.eventually_inner_gradient_le [μ.IsAddHaarMeasure]
    (hψ : IsBoundedMollifierSequence ψ μ) (hf : ∀ y, StrictlyContinuousAt f y) {x w : E} {b : ℝ}
    (hb : regularSubderivative (fun y ↦ (f y : EReal)) x w < b) :
    ∃ δ > 0, ∀ᶠ n in atTop, ∀ z ∈ ball x δ,
      ⟪gradient (mollifiedAverage μ (ψ n) f) z, w⟫_ℝ ≤ b := by
  have hfc := continuous_of_forall_strictlyContinuousAt hf
  have hsc : ERealStrictlyContinuousAt (fun y ↦ (f y : EReal)) x :=
    ⟨by simp, by simpa only [EReal.toReal_coe] using hf x⟩
  rw [hsc.regularSubderivative_eq_limsup_differenceQuotient] at hb
  have hev := eventually_lt_of_limsup_lt hb
  obtain ⟨U, hU, T, hT, hUT⟩ := mem_prod_iff.1 hev
  obtain ⟨r, hr, hrU⟩ := Metric.mem_nhds_iff.1 hU
  obtain ⟨ε, hε, hεT⟩ := mem_nhdsGT_iff_exists_Ioo_subset.1 hT
  refine ⟨r / 2, half_pos hr, ?_⟩
  filter_upwards [(tendsto_smallSets_iff.1 hψ.tendsto_support_smallSets) (ball 0 (r / 2))
    (ball_mem_nhds _ (half_pos hr))] with n hn z hz
  have hgrad := hψ.hasGradientAt hf n z
  rw [hgrad.gradient]
  have hslope : ∀ τ ∈ Ioo (0 : ℝ) ε,
      τ⁻¹ * (mollifiedAverage μ (ψ n) f (z + τ • w) - mollifiedAverage μ (ψ n) f z) ≤ b := by
    intro τ hτ
    rw [hψ.mollifiedAverage_add_smul_sub n hfc, inv_mul_le_iff₀ hτ.1]
    have hint1 : Integrable (fun t ↦ ψ n t * (f (z - t + τ • w) - f (z - t))) μ := by
      have h := (hψ.mollifiedAverage_add_smul_sub n hfc z w τ)
      obtain ⟨M, hM⟩ := hψ.bounded n
      obtain ⟨R, hR⟩ := (isBounded_iff_subset_closedBall (0 : E)).mp hψ.bounded_supports
      have hA : ∀ z, |ψ n z| ≤ M := fun z ↦ by rw [abs_of_nonneg (hψ.nonneg n z)]; exact hM z
      have hR' : support (ψ n) ⊆ closedBall 0 R := fun z hz ↦ hR (mem_iUnion.2 ⟨n, hz⟩)
      have h1 := integrable_kernel_mul_comp_sub (μ := μ) (hψ.measurable n) hA hR' hfc (z + τ • w)
      have h2 := integrable_kernel_mul_comp_sub (μ := μ) (hψ.measurable n) hA hR' hfc z
      refine (h1.sub h2).congr (Eventually.of_forall fun t ↦ ?_)
      simp only [Pi.sub_apply]
      rw [add_sub_right_comm, mul_sub]
    have hint2 : Integrable (fun t ↦ ψ n t * (τ * b)) μ :=
      (integrable_of_integral_eq_one (hψ.integral_eq_one n)).mul_const _
    calc ∫ t, ψ n t * (f (z - t + τ • w) - f (z - t)) ∂μ ≤ ∫ t, ψ n t * (τ * b) ∂μ := by
          refine integral_mono hint1 hint2 fun t ↦ ?_
          by_cases ht : ψ n t = 0
          · simp [ht]
          · have htb : t ∈ ball (0 : E) (r / 2) := hn ht
            have hzt : z - t ∈ U := by
              apply hrU
              rw [mem_ball, dist_eq_norm] at hz ⊢
              rw [mem_ball_zero_iff] at htb
              calc ‖z - t - x‖ = ‖(z - x) - t‖ := by congr 1; abel
                _ ≤ ‖z - x‖ + ‖t‖ := norm_sub_le _ _
                _ < r := by linarith
            have hq := hUT (mk_mem_prod hzt (hεT hτ))
            simp only [mem_setOf_eq] at hq
            rw [differenceQuotient_eq_coe (f := fun y ↦ (f y : EReal)) rfl rfl,
              EReal.coe_lt_coe_iff, inv_mul_lt_iff₀ hτ.1] at hq
            exact mul_le_mul_of_nonneg_left hq.le (hψ.nonneg n t)
      _ = τ * b := by rw [integral_mul_const, hψ.integral_eq_one n, one_mul]
  have hlim := ((hasGradientAt_iff_hasFDerivAt.1 hgrad).hasLineDerivAt w).tendsto_slope_zero_right
  rw [toDual_apply_apply] at hlim
  refine le_of_tendsto hlim ?_
  filter_upwards [Ioo_mem_nhdsGT hε] with τ hτ
  simpa only [smul_eq_mul] using hslope τ hτ

/-- Every element of `G(x̄)` is a Clarke subgradient: `⟪v, w⟫ ≤ d̂f(x̄)(w)` for all `w`. -/
theorem IsBoundedMollifierSequence.inner_le_regularSubderivative [μ.IsAddHaarMeasure]
    (hψ : IsBoundedMollifierSequence ψ μ) (hf : ∀ y, StrictlyContinuousAt f y) {x v : E}
    (hv : v ∈ mollifierGradientLimits μ ψ f x) (w : E) :
    ((⟪v, w⟫_ℝ : ℝ) : EReal) ≤ regularSubderivative (fun y ↦ (f y : EReal)) x w := by
  by_contra hlt
  push_neg at hlt
  obtain ⟨b, hb1, hb2⟩ := EReal.exists_between_coe_real hlt
  obtain ⟨δ, hδ, hev⟩ := hψ.eventually_inner_gradient_le hf hb1
  obtain ⟨φ, hφ, z, hz, hlim⟩ := mem_mollifierGradientLimits_iff.1 hv
  have hle : ⟪v, w⟫_ℝ ≤ b := by
    refine le_of_tendsto (hlim.inner tendsto_const_nhds) ?_
    filter_upwards [hφ.tendsto_atTop.eventually hev, hz.eventually (ball_mem_nhds x hδ)]
      with k hk hzk
    exact hk (z k) hzk
  exact (not_lt.2 hle) (EReal.coe_lt_coe_iff.1 hb2)

/-- Proximal subgradients belong to `G(x̄)` (first step of the proof of 9.67). -/
theorem IsBoundedMollifierSequence.proximalSubdifferential_subset [μ.IsAddHaarMeasure]
    (hψ : IsBoundedMollifierSequence ψ μ) (hf : ∀ y, StrictlyContinuousAt f y) (x : E) :
    proximalSubdifferential (fun y ↦ (f y : EReal)) x ⊆ mollifierGradientLimits μ ψ f x := by
  intro v hv
  obtain ⟨c, hc, ρ, hρ, δ, hδ, hprox⟩ := hv
  have hc' : ((f x : ℝ) : EReal) = c := hc
  have hfx : f x = c := by exact_mod_cast hc'
  have hfc := continuous_of_forall_strictlyContinuousAt hf
  set h : E → ℝ := fun y ↦ ⟪v, y - x⟫_ℝ - ρ * ‖y - x‖ ^ 2 with hh
  have hhd : ∀ y, HasFDerivAt h
      (innerSL ℝ v - ρ • (2 • (innerSL ℝ (y - x)).comp (ContinuousLinearMap.id ℝ E))) y := by
    intro y
    have h1 : HasFDerivAt (fun y ↦ ⟪v, y - x⟫_ℝ) (innerSL ℝ v) y := by
      have := ((innerSL ℝ v).hasFDerivAt (x := y - x)).comp y ((hasFDerivAt_id y).sub_const x)
      simpa using this
    have h2 : HasFDerivAt (fun y ↦ ‖y - x‖ ^ 2)
        (2 • (innerSL ℝ (y - x)).comp (ContinuousLinearMap.id ℝ E)) y :=
      ((hasFDerivAt_id y).sub_const x).norm_sq
    exact h1.sub (h2.const_mul ρ)
  have hcd : ContDiff ℝ 1 h := by
    have h1 : ContDiff ℝ 1 (fun y ↦ ⟪v, y - x⟫_ℝ) :=
      contDiff_const.inner ℝ (contDiff_id.sub contDiff_const)
    have h2 : ContDiff ℝ 1 (fun y ↦ ‖y - x‖ ^ 2) := (contDiff_id.sub contDiff_const).norm_sq ℝ
    exact h1.sub (contDiff_const.mul h2)
  have hhsc : ∀ y, StrictlyContinuousAt h y := fun y ↦
    strictlyContinuousAt_iff.2 ((hcd.contDiffAt.hasStrictFDerivAt (by norm_num)).exists_lipschitzOnWith)
  have hgh_cont : Continuous (gradient h) :=
    (toDual ℝ E).symm.continuous.comp (hcd.continuous_fderiv one_ne_zero)
  have hgx : gradient h x = v := by
    have hd : HasFDerivAt h (toDual ℝ E v) x := by
      convert hhd x using 1
      ext w
      simp [toDual_apply_apply]
    simp [gradient, hd.fderiv]
  set g : E → ℝ := fun y ↦ f y - h y with hgdef
  have hgc : Continuous g := hfc.sub hcd.continuous
  have hgrowth : ∀ y ∈ closedBall x δ, g x + ρ / 2 * ‖y - x‖ ^ 2 ≤ g y := by
    intro y hy
    have h1 : ((c + ⟪v, y - x⟫_ℝ - ρ / 2 * ‖y - x‖ ^ 2 : ℝ) : EReal) ≤ ((f y : ℝ) : EReal) :=
      hprox y (by rwa [mem_closedBall, dist_eq_norm] at hy)
    have h1' : c + ⟪v, y - x⟫_ℝ - ρ / 2 * ‖y - x‖ ^ 2 ≤ f y := by exact_mod_cast h1
    simp only [hgdef, hh, sub_self, inner_zero_right, norm_zero]
    nlinarith [sq_nonneg ‖y - x‖]
  -- the averages of `g` split as averages of `f` and `h`
  obtain ⟨M, hM⟩ := hψ.bounded 0
  have hsplit : ∀ n y, mollifiedAverage μ (ψ n) g y =
      mollifiedAverage μ (ψ n) f y - mollifiedAverage μ (ψ n) h y := by
    intro n y
    obtain ⟨M, hM⟩ := hψ.bounded n
    obtain ⟨R, hR⟩ := (isBounded_iff_subset_closedBall (0 : E)).mp hψ.bounded_supports
    have hA : ∀ z, |ψ n z| ≤ M := fun z ↦ by rw [abs_of_nonneg (hψ.nonneg n z)]; exact hM z
    have hR' : support (ψ n) ⊆ closedBall 0 R := fun z hz ↦ hR (mem_iUnion.2 ⟨n, hz⟩)
    rw [mollifiedAverage, mollifiedAverage, mollifiedAverage,
      ← integral_sub (integrable_kernel_mul_comp_sub (μ := μ) (hψ.measurable n) hA hR' hfc y)
        (integrable_kernel_mul_comp_sub (μ := μ) (hψ.measurable n) hA hR' hcd.continuous y)]
    congr 1
    ext t
    rw [hgdef, mul_sub]
  have hFc : ∀ n, Continuous (mollifiedAverage μ (ψ n) f) := fun n ↦
    continuous_iff_continuousAt.2 fun y ↦
      (hasGradientAt_iff_hasFDerivAt.1 (hψ.hasGradientAt hf n y)).continuousAt
  have hHc : ∀ n, Continuous (mollifiedAverage μ (ψ n) h) := fun n ↦
    continuous_iff_continuousAt.2 fun y ↦
      (hasGradientAt_iff_hasFDerivAt.1 (hψ.hasGradientAt hhsc n y)).continuousAt
  have hmin : ∀ n, ∃ y ∈ closedBall x δ, IsMinOn (fun y ↦ mollifiedAverage μ (ψ n) f y -
      mollifiedAverage μ (ψ n) h y) (closedBall x δ) y := fun n ↦
    (isCompact_closedBall x δ).exists_isMinOn (nonempty_closedBall.2 hδ.le)
      ((hFc n).sub (hHc n)).continuousOn
  choose xs hxs hxmin using hmin
  have hU := hψ.tendstoUniformlyOn_mollifiedAverage hgc.locallyIntegrable
    (isCompact_closedBall x δ) (fun y _ ↦ hgc.continuousAt)
  have hconv : Tendsto xs atTop (𝓝 x) := by
    rw [Metric.tendsto_nhds]
    intro η hη
    set η' := min η δ with hη'def
    have hη' : 0 < η' := lt_min hη hδ
    set m := ρ / 2 * η' ^ 2 / 2 with hm
    have hm0 : 0 < m := by positivity
    filter_upwards [(Metric.tendstoUniformlyOn_iff.1 hU) m hm0] with n hn
    by_contra hfar
    push_neg at hfar
    have hfar' : η' ≤ ‖xs n - x‖ := (min_le_left _ _).trans (by rwa [← dist_eq_norm])
    have h1 := hn (xs n) (hxs n)
    have h2 := hn x (mem_closedBall_self hδ.le)
    have h3 := hgrowth (xs n) (hxs n)
    have h4 := hxmin n (mem_closedBall_self hδ.le)
    simp only [mem_setOf_eq] at h4
    rw [hsplit, Real.dist_eq, abs_lt] at h1 h2
    have h5 : ρ / 2 * η' ^ 2 ≤ ρ / 2 * ‖xs n - x‖ ^ 2 := by gcongr
    linarith
  have hgradeq : ∀ᶠ n in atTop, gradient (mollifiedAverage μ (ψ n) f) (xs n) =
      ∫ t, ψ n t • gradient h (xs n - t) ∂μ := by
    filter_upwards [hconv.eventually (ball_mem_nhds x hδ)] with n hn
    have hloc : IsLocalMin (fun y ↦ mollifiedAverage μ (ψ n) f y -
        mollifiedAverage μ (ψ n) h y) (xs n) :=
      (hxmin n).isLocalMin (mem_of_superset (isOpen_ball.mem_nhds hn) ball_subset_closedBall)
    have hF := hψ.hasGradientAt hf n (xs n)
    have hH := hψ.hasGradientAt hhsc n (xs n)
    have hd := (hasGradientAt_iff_hasFDerivAt.1 hF).sub (hasGradientAt_iff_hasFDerivAt.1 hH)
    have h0 := hloc.hasFDerivAt_eq_zero hd
    rw [← map_sub, LinearIsometryEquiv.map_eq_zero_iff, sub_eq_zero] at h0
    rw [hF.gradient, h0]
  have hlim : Tendsto (fun n ↦ ∫ t, ψ n t • gradient h (xs n - t) ∂μ) atTop (𝓝 v) := by
    have h := convolution_tendsto_right (μ := μ) (g := fun _ : ℕ ↦ gradient h) (φ := ψ) (k := xs)
      (z₀ := gradient h x) (Eventually.of_forall hψ.nonneg)
      (Eventually.of_forall hψ.integral_eq_one) hψ.tendsto_support_smallSets
      (Eventually.of_forall fun _ ↦ hgh_cont.aestronglyMeasurable)
      ((hgh_cont.tendsto x).comp tendsto_snd) hconv
    rw [hgx] at h
    exact h
  exact mem_mollifierGradientLimits_iff.2
    ⟨id, strictMono_id, xs, hconv, hlim.congr' (hgradeq.mono fun n hn ↦ hn.symm)⟩

/-- **Theorem 9.67**, `∂f(x̄) ⊂ G(x̄)`. -/
theorem IsBoundedMollifierSequence.subdifferential_subset [μ.IsAddHaarMeasure]
    (hψ : IsBoundedMollifierSequence ψ μ) (hf : ∀ y, StrictlyContinuousAt f y) (x : E) :
    subdifferential (fun y ↦ (f y : EReal)) x ⊆ mollifierGradientLimits μ ψ f x := by
  intro v hv
  have hfc := continuous_of_forall_strictlyContinuousAt hf
  have hlsc : LowerSemicontinuous (fun y ↦ (f y : EReal)) :=
    (continuous_coe_real_ereal.comp hfc).lowerSemicontinuous
  have happrox : ∀ k : ℕ, ∃ x' v' : E, ‖x' - x‖ ≤ 1 / ((k : ℝ) + 1) ∧
      ‖v' - v‖ ≤ 1 / ((k : ℝ) + 1) ∧ v' ∈ proximalSubdifferential (fun y ↦ (f y : EReal)) x' := by
    intro k
    obtain ⟨x', v', c', -, hx', -, hv', hvv⟩ :=
      exists_mem_proximalSubdifferential_close hlsc rfl hv Nat.one_div_pos_of_nat
    exact ⟨x', v', hx', hvv, hv'⟩
  choose xs vs hxs hvs hprox using happrox
  have hmem : ∀ k, (xs k, vs k) ∈ {p : E × E | p.2 ∈ mollifierGradientLimits μ ψ f p.1} :=
    fun k ↦ hψ.proximalSubdifferential_subset hf (xs k) (hprox k)
  have hx : Tendsto xs atTop (𝓝 x) := tendsto_iff_norm_sub_tendsto_zero.2
    (squeeze_zero (fun _ ↦ norm_nonneg _) hxs tendsto_one_div_add_atTop_nhds_zero_nat)
  have hv' : Tendsto vs atTop (𝓝 v) := tendsto_iff_norm_sub_tendsto_zero.2
    (squeeze_zero (fun _ ↦ norm_nonneg _) hvs tendsto_one_div_add_atTop_nhds_zero_nat)
  exact (isClosed_graph_mollifierGradientLimits μ ψ f).mem_of_tendsto (hx.prodMk_nhds hv')
    (Eventually.of_forall hmem)

omit [MeasurableSpace E] [BorelSpace E] in
private theorem clarkeSubdifferential_eq_convexHull_aux {g : E → EReal} {x : E}
    (hg : ERealStrictlyContinuousAt g x) :
    clarkeSubdifferential g x = convexHull ℝ (subdifferential g x) := by
  rw [clarkeSubdifferential_eq_setOf_inner_le_regularSubderivative hg.finite hg.isLocallyLscAt,
    funext hg.regularSubderivative_eq_supportFunction]
  change linearMinorantSet (supportFunction (subdifferential g x)) = _
  rw [linearMinorantSet_supportFunction]
  exact (isCompact_convexHull hg.subdifferential_nonempty_compact.2).isClosed.closure_eq

/-- `G(x̄) ⊂ ∂̄f(x̄)`: limits of averaged gradients are Clarke subgradients. -/
theorem IsBoundedMollifierSequence.mollifierGradientLimits_subset_clarkeSubdifferential
    [μ.IsAddHaarMeasure] (hψ : IsBoundedMollifierSequence ψ μ)
    (hf : ∀ y, StrictlyContinuousAt f y) (x : E) :
    mollifierGradientLimits μ ψ f x ⊆ clarkeSubdifferential (fun y ↦ (f y : EReal)) x := by
  have hsc : ERealStrictlyContinuousAt (fun y ↦ (f y : EReal)) x :=
    ⟨by simp, by simpa only [EReal.toReal_coe] using hf x⟩
  intro v hv
  rw [clarkeSubdifferential_eq_setOf_inner_le_regularSubderivative
    (f := fun y ↦ (f y : EReal)) (c := f x) rfl hsc.isLocallyLscAt]
  exact fun w ↦ hψ.inner_le_regularSubderivative hf hv w

/-- `G(x̄)` is nonempty and compact. -/
theorem IsBoundedMollifierSequence.mollifierGradientLimits_nonempty_compact [μ.IsAddHaarMeasure]
    (hψ : IsBoundedMollifierSequence ψ μ) (hf : ∀ y, StrictlyContinuousAt f y) (x : E) :
    (mollifierGradientLimits μ ψ f x).Nonempty ∧ IsCompact (mollifierGradientLimits μ ψ f x) := by
  have hsc : ERealStrictlyContinuousAt (fun y ↦ (f y : EReal)) x :=
    ⟨by simp, by simpa only [EReal.toReal_coe] using hf x⟩
  obtain ⟨hne, hcpt⟩ := hsc.subdifferential_nonempty_compact
  refine ⟨hne.mono (hψ.subdifferential_subset hf x), ?_⟩
  have hG := hψ.mollifierGradientLimits_subset_clarkeSubdifferential hf x
  rw [clarkeSubdifferential_eq_convexHull_aux hsc] at hG
  have hclosed : IsClosed (mollifierGradientLimits μ ψ f x) :=
    (isClosed_graph_mollifierGradientLimits μ ψ f).preimage (continuous_const.prodMk continuous_id)
  exact (isCompact_convexHull hcpt).of_isClosed_subset hclosed hG

/-- **Theorem 9.67**: for a strictly continuous `f` and bounded continuous mollifiers, the
averages `f^ν` are `C¹` and converge uniformly to `f` on compact sets, and at every `x̄`,
`∂f(x̄) ⊂ G(x̄)`, `con ∂f(x̄) = con G(x̄)`, and `∂f(x̄) = G(x̄)` when `f` is subdifferentially
regular at `x̄`.  (Continuity of the kernels is used only for the continuity of `∇f^ν`.) -/
theorem mollifier_subgradients [μ.IsAddHaarMeasure] (hψ : IsBoundedMollifierSequence ψ μ)
    (hψc : ∀ n, Continuous (ψ n)) (hf : ∀ y, StrictlyContinuousAt f y) :
    (∀ n, ContDiff ℝ 1 (mollifiedAverage μ (ψ n) f)) ∧
    (∀ B : Set E, IsCompact B →
      TendstoUniformlyOn (fun n ↦ mollifiedAverage μ (ψ n) f) f atTop B) ∧
    ∀ x, subdifferential (fun y ↦ (f y : EReal)) x ⊆ mollifierGradientLimits μ ψ f x ∧
      convexHull ℝ (subdifferential (fun y ↦ (f y : EReal)) x) =
        convexHull ℝ (mollifierGradientLimits μ ψ f x) ∧
      (IsSubdifferentiallyRegularAt (fun y ↦ (f y : EReal)) x →
        subdifferential (fun y ↦ (f y : EReal)) x = mollifierGradientLimits μ ψ f x) := by
  have hfc := continuous_of_forall_strictlyContinuousAt hf
  refine ⟨fun n ↦ ?_, fun B hB ↦ ?_, fun x ↦ ?_⟩
  · obtain ⟨M, hM⟩ := hψ.bounded n
    obtain ⟨R, hR⟩ := (isBounded_iff_subset_closedBall (0 : E)).mp hψ.bounded_supports
    exact contDiff_mollifiedAverage (hψc n) (hψ.nonneg n) hM
      (fun z hz ↦ hR (mem_iUnion.2 ⟨n, hz⟩)) hf
  · exact hψ.tendstoUniformlyOn_mollifiedAverage hfc.locallyIntegrable hB
      (fun y _ ↦ hfc.continuousAt)
  have hsc : ERealStrictlyContinuousAt (fun y ↦ (f y : EReal)) x :=
    ⟨by simp, by simpa only [EReal.toReal_coe] using hf x⟩
  have hsub := hψ.subdifferential_subset hf x
  have hG := hψ.mollifierGradientLimits_subset_clarkeSubdifferential hf x
  rw [clarkeSubdifferential_eq_convexHull_aux hsc] at hG
  have hconv : convexHull ℝ (subdifferential (fun y ↦ (f y : EReal)) x) =
      convexHull ℝ (mollifierGradientLimits μ ψ f x) :=
    Subset.antisymm (convexHull_mono hsub) (convexHull_min hG (convex_convexHull ℝ _))
  refine ⟨hsub, hconv, fun hreg ↦ ?_⟩
  have hcx : Convex ℝ (subdifferential (fun y ↦ (f y : EReal)) x) := by
    rw [hreg.subdifferential_eq_regularSubdifferential]
    exact (subdifferential_properties (f := fun y ↦ (f y : EReal)) (x := x) (c := f x) rfl).2.1
  refine Subset.antisymm hsub ?_
  calc mollifierGradientLimits μ ψ f x ⊆ convexHull ℝ (mollifierGradientLimits μ ψ f x) :=
        subset_convexHull ℝ _
    _ = convexHull ℝ (subdifferential (fun y ↦ (f y : EReal)) x) := hconv.symm
    _ = subdifferential (fun y ↦ (f y : EReal)) x := hcx.convexHull_eq

/-! ### Choice of the kernels: the Clarke subdifferential -/

omit [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E] in
/-- Sets that are eventually nonempty and shrink into every neighborhood of `x` converge to
`{x}` in the Painlevé–Kuratowski sense. -/
theorem pkConverges_singleton_of_tendsto_smallSets {S : ℕ → Set E} {x : E}
    (hne : ∀ᶠ n in atTop, (S n).Nonempty) (h : Tendsto S atTop (𝓝 x).smallSets) :
    PKConverges S {x} := by
  have hout : outerSetLimit S ⊆ {x} := by
    intro p hp
    by_contra hpx
    have hd : 0 < dist p x := dist_pos.2 hpx
    have h1 := hp (ball p (dist p x / 2)) (ball_mem_nhds p (half_pos hd))
    have h2 := (tendsto_smallSets_iff.1 h) (ball x (dist p x / 2)) (ball_mem_nhds x (half_pos hd))
    obtain ⟨n, ⟨y, hyS, hyp⟩, hn⟩ := (h1.and_eventually h2).exists
    have hyx := hn hyS
    rw [mem_ball] at hyp hyx
    have := dist_triangle_left p x y
    linarith
  have hin : {x} ⊆ innerSetLimit S := by
    rintro _ rfl V hV
    filter_upwards [hne, (tendsto_smallSets_iff.1 h) V hV] with n hn hsub
    obtain ⟨y, hy⟩ := hn
    exact ⟨y, hy, hsub hy⟩
  have hio := innerSetLimit_subset_outerSetLimit S
  exact ⟨(hio.trans hout).antisymm hin, hout.antisymm (hin.trans hio)⟩

omit [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E] in
private theorem one_div_succ_pos (n : ℕ) : 0 < 1 / ((n : ℝ) + 1) := Nat.one_div_pos_of_nat

/-- The smooth bump functions used for the standard kernels: `1` near the origin and supported
in `ball 0 (1 / (n + 1))`. -/
noncomputable def standardBump (n : ℕ) : ContDiffBump (0 : E) where
  rIn := 1 / (2 * ((n : ℝ) + 1))
  rOut := 1 / ((n : ℝ) + 1)
  rIn_pos := by positivity
  rIn_lt_rOut := by
    apply one_div_lt_one_div_of_lt (by positivity)
    have : (0 : ℝ) < (n : ℝ) + 1 := by positivity
    linarith

/-- A standard sequence of continuous bounded mollifiers: normalized smooth bump functions
supported in `ball 0 (1 / (n + 1))`. -/
noncomputable def standardMollifier (μ : Measure E) (n : ℕ) : E → ℝ :=
  (standardBump (E := E) n).normed μ

theorem support_standardMollifier (μ : Measure E) [μ.IsAddHaarMeasure] (n : ℕ) :
    support (standardMollifier μ n) = ball (0 : E) (1 / ((n : ℝ) + 1)) :=
  (standardBump n).support_normed_eq

/-- Continuous bounded mollifier sequences exist. -/
theorem isBoundedMollifierSequence_standardMollifier (μ : Measure E) [μ.IsAddHaarMeasure] :
    IsBoundedMollifierSequence (standardMollifier μ) μ ∧
      ∀ n, Continuous (standardMollifier (E := E) μ n) := by
  have hc : ∀ n, Continuous (standardMollifier (E := E) μ n) :=
    fun n ↦ (standardBump n).continuous_normed
  refine ⟨⟨fun n z ↦ (standardBump n).nonneg_normed z, fun n ↦ (hc n).measurable,
    fun n ↦ ?_, fun n ↦ (standardBump n).integral_normed, ?_, ?_⟩, hc⟩
  · obtain ⟨C, hC⟩ := (hc n).bounded_above_of_compact_support
      (standardBump (E := E) n).hasCompactSupport_normed
    exact ⟨C, fun z ↦ (le_abs_self _).trans (by simpa only [Real.norm_eq_abs] using hC z)⟩
  · refine (isBounded_ball (x := (0 : E)) (r := 1)).subset (iUnion_subset fun n ↦ ?_)
    rw [support_standardMollifier]
    refine ball_subset_ball ?_
    rw [div_le_one (by positivity)]
    have : (0 : ℝ) ≤ n := Nat.cast_nonneg n
    linarith
  · refine pkConverges_singleton_of_tendsto_smallSets (Eventually.of_forall fun n ↦ ?_) ?_
    · rw [support_standardMollifier]
      exact nonempty_ball.2 (one_div_succ_pos n)
    · rw [tendsto_smallSets_iff]
      intro V hV
      obtain ⟨ε, hε, hεV⟩ := Metric.mem_nhds_iff.1 hV
      obtain ⟨N, hN⟩ := exists_nat_one_div_lt hε
      filter_upwards [eventually_ge_atTop N] with n hn
      rw [support_standardMollifier]
      refine (ball_subset_ball ?_).trans hεV
      refine le_trans ?_ hN.le
      apply one_div_le_one_div_of_le (by positivity)
      exact_mod_cast Nat.add_le_add_right hn 1

omit [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] in
/-- Averages against a translated kernel are translated averages. -/
theorem mollifiedAverage_translate (μ : Measure E) [μ.IsAddHaarMeasure] (ψ f : E → ℝ)
    (c y : E) :
    mollifiedAverage μ (fun t ↦ ψ (t + c)) f y = mollifiedAverage μ ψ f (y + c) := by
  unfold mollifiedAverage
  rw [← integral_add_right_eq_self (μ := μ) (fun s ↦ ψ s * f (y + c - s)) c]
  congr 1
  ext t
  rw [add_sub_add_right_eq_sub]

omit [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E] in
theorem support_mixedKernel_subset {ι : Type*} [Fintype ι] (w : ι → ℝ) (ψ : ι → E → ℝ)
    (c : ι → E) {t : E} (ht : t ∈ support (fun t ↦ ∑ i, w i * ψ i (t + c i))) :
    ∃ i, t + c i ∈ support (ψ i) := by
  by_contra h
  push_neg at h
  apply ht
  exact Finset.sum_eq_zero fun i _ ↦ by rw [notMem_support.1 (h i), mul_zero]

/-- Averages against a mixture of translated kernels are mixtures of translated averages. -/
theorem mollifiedAverage_mixedKernel (μ : Measure E) [μ.IsAddHaarMeasure] {ι : Type*}
    [Fintype ι] (w : ι → ℝ) {ψ : ι → E → ℝ} (hψm : ∀ i, Measurable (ψ i))
    (hψM : ∀ i, ∃ M, ∀ z, |ψ i z| ≤ M) (hψR : ∀ i, ∃ R, support (ψ i) ⊆ closedBall 0 R)
    (c : ι → E) {f : E → ℝ} (hfc : Continuous f) (y : E) :
    mollifiedAverage μ (fun t ↦ ∑ i, w i * ψ i (t + c i)) f y =
      ∑ i, w i * mollifiedAverage μ (ψ i) f (y + c i) := by
  have hint : ∀ i, Integrable (fun t ↦ ψ i (t + c i) * f (y - t)) μ := by
    intro i
    obtain ⟨M, hM⟩ := hψM i
    obtain ⟨R, hR⟩ := hψR i
    have h := (integrable_kernel_mul_comp_sub (μ := μ) (hψm i) hM hR hfc (y + c i)).comp_add_right
      (c i)
    refine h.congr (Eventually.of_forall fun t ↦ ?_)
    simp only [add_sub_add_right_eq_sub]
  rw [mollifiedAverage]
  simp_rw [Finset.sum_mul, mul_assoc]
  rw [integral_finset_sum _ (fun i _ ↦ (hint i).const_mul (w i))]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [integral_const_mul, ← mollifiedAverage_translate]
  rfl

/-- The gradient at `x̄` of the average against a mixture of translated kernels. -/
theorem gradient_mollifiedAverage_mixedKernel (μ : Measure E) [μ.IsAddHaarMeasure] {ι : Type*}
    [Fintype ι] (w : ι → ℝ) {ψ : ι → E → ℝ} (hψm : ∀ i, Measurable (ψ i))
    (hψ0 : ∀ i z, 0 ≤ ψ i z) (hψM : ∀ i, ∃ M, ∀ z, ψ i z ≤ M)
    (hψR : ∀ i, ∃ R, support (ψ i) ⊆ closedBall 0 R) (c : ι → E) {f : E → ℝ}
    (hf : ∀ y, StrictlyContinuousAt f y) (x : E) :
    gradient (mollifiedAverage μ (fun t ↦ ∑ i, w i * ψ i (t + c i)) f) x =
      ∑ i, w i • gradient (mollifiedAverage μ (ψ i) f) (x + c i) := by
  have hfc := continuous_of_forall_strictlyContinuousAt hf
  have hψA : ∀ i, ∃ M, ∀ z, |ψ i z| ≤ M := fun i ↦ by
    obtain ⟨M, hM⟩ := hψM i
    exact ⟨M, fun z ↦ by rw [abs_of_nonneg (hψ0 i z)]; exact hM z⟩
  have heq : mollifiedAverage μ (fun t ↦ ∑ i, w i * ψ i (t + c i)) f =
      fun y ↦ ∑ i, w i * mollifiedAverage μ (ψ i) f (y + c i) :=
    funext (mollifiedAverage_mixedKernel μ w hψm hψA hψR c hfc)
  have hg : ∀ i, HasFDerivAt (fun y ↦ mollifiedAverage μ (ψ i) f (y + c i))
      (toDual ℝ E (gradient (mollifiedAverage μ (ψ i) f) (x + c i))) x := by
    intro i
    obtain ⟨M, hM⟩ := hψM i
    obtain ⟨R, hR⟩ := hψR i
    have h1 := hasGradientAt_mollifiedAverage (μ := μ) (hψm i) (hψ0 i) hM hR hf (x + c i)
    rw [← h1.gradient] at h1
    have h2 := (hasGradientAt_iff_hasFDerivAt.1 h1).comp x ((hasFDerivAt_id x).add_const (c i))
    simpa using h2
  have hsum : HasFDerivAt (fun y ↦ ∑ i, w i * mollifiedAverage μ (ψ i) f (y + c i))
      (∑ i, w i • toDual ℝ E (gradient (mollifiedAverage μ (ψ i) f) (x + c i))) x := by
    have h := HasFDerivAt.sum (u := Finset.univ) fun i _ ↦ (hg i).const_mul (w i)
    convert h using 1
    ext y
    simp only [Finset.sum_apply]
  have hdual : (∑ i, w i • toDual ℝ E (gradient (mollifiedAverage μ (ψ i) f) (x + c i))) =
      toDual ℝ E (∑ i, w i • gradient (mollifiedAverage μ (ψ i) f) (x + c i)) := by
    ext u
    simp [toDual_apply_apply]
  rw [hdual] at hsum
  rw [heq]
  exact (hasGradientAt_iff_hasFDerivAt.2 hsum).gradient

/-- Translating and mixing kernels: from points of `G(x̄)` for a bounded mollifier sequence,
any convex combination is the limit of gradients at `x̄` itself for another bounded mollifier
sequence, continuous when the given one is. -/
theorem IsBoundedMollifierSequence.exists_mixed_tendsto_gradient [μ.IsAddHaarMeasure]
    (hψ : IsBoundedMollifierSequence ψ μ) (hf : ∀ y, StrictlyContinuousAt f y) {x : E}
    {ι : Type*} [Fintype ι] (w : ι → ℝ) (hw0 : ∀ i, 0 ≤ w i) (hw1 : ∑ i, w i = 1) (u : ι → E)
    (hu : ∀ i, u i ∈ mollifierGradientLimits μ ψ f x) :
    ∃ ψ' : ℕ → E → ℝ, IsBoundedMollifierSequence ψ' μ ∧
      ((∀ n, Continuous (ψ n)) → ∀ n, Continuous (ψ' n)) ∧
      Tendsto (fun n ↦ gradient (mollifiedAverage μ (ψ' n) f) x) atTop (𝓝 (∑ i, w i • u i)) := by
  choose φ hφ z hz hlim using fun i ↦ mem_mollifierGradientLimits_iff.1 (hu i)
  set c : ι → ℕ → E := fun i k ↦ z i k - x with hcdef
  set ψ' : ℕ → E → ℝ := fun k t ↦ ∑ i, w i * ψ (φ i k) (t + c i k) with hψ'def
  obtain ⟨R, hR⟩ := (isBounded_iff_subset_closedBall (0 : E)).mp hψ.bounded_supports
  have hRn : ∀ n, support (ψ n) ⊆ closedBall 0 R := fun n z hz ↦ hR (mem_iUnion.2 ⟨n, hz⟩)
  have hc : ∀ i, Tendsto (c i) atTop (𝓝 0) := fun i ↦ by
    simpa [hcdef] using (hz i).sub_const x
  -- bounds on the translations
  have hcb : IsBounded (⋃ i, range (c i)) :=
    isBounded_iUnion.2 fun i ↦ isBounded_range_of_tendsto (c i) (hc i)
  obtain ⟨B, hB⟩ := hcb.exists_norm_le
  have hcB : ∀ i k, ‖c i k‖ ≤ B := fun i k ↦ hB _ (mem_iUnion.2 ⟨i, mem_range_self k⟩)
  have hint1 : ∀ i k, Integrable (fun t ↦ ψ (φ i k) (t + c i k)) μ := fun i k ↦
    (integrable_of_integral_eq_one (hψ.integral_eq_one _)).comp_add_right _
  refine ⟨ψ', ⟨fun k t ↦ ?_, fun k ↦ ?_, fun k ↦ ?_, fun k ↦ ?_, ?_, ?_⟩, fun hcont k ↦ ?_, ?_⟩
  · exact Finset.sum_nonneg fun i _ ↦ mul_nonneg (hw0 i) (hψ.nonneg _ _)
  · exact Finset.measurable_sum _ fun i _ ↦
      measurable_const.mul ((hψ.measurable _).comp (measurable_id.add_const _))
  · choose M hM using fun i ↦ hψ.bounded (φ i k)
    refine ⟨∑ i, w i * M i, fun t ↦ Finset.sum_le_sum fun i _ ↦ ?_⟩
    exact mul_le_mul_of_nonneg_left (hM i _) (hw0 i)
  · simp only [hψ'def]
    rw [integral_finset_sum _ (fun i _ ↦ (hint1 i k).const_mul (w i))]
    simp_rw [integral_const_mul]
    rw [← hw1]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [integral_add_right_eq_self (μ := μ) (fun s ↦ ψ (φ i k) s), hψ.integral_eq_one, mul_one]
  · refine isBounded_closedBall (x := (0 : E)) (r := R + B) |>.subset (iUnion_subset fun k ↦ ?_)
    intro t ht
    obtain ⟨i, hi⟩ := support_mixedKernel_subset w (fun i ↦ ψ (φ i k)) (fun i ↦ c i k) ht
    have h1 := mem_closedBall_zero_iff.1 (hRn _ hi)
    rw [mem_closedBall_zero_iff]
    calc ‖t‖ = ‖(t + c i k) - c i k‖ := by rw [add_sub_cancel_right]
      _ ≤ ‖t + c i k‖ + ‖c i k‖ := norm_sub_le _ _
      _ ≤ R + B := add_le_add h1 (hcB i k)
  · refine pkConverges_singleton_of_tendsto_smallSets (Eventually.of_forall fun k ↦ ?_) ?_
    · by_contra hne
      rw [not_nonempty_iff_eq_empty, support_eq_empty_iff] at hne
      have h1 : ∫ t, ψ' k t ∂μ = 1 := by
        simp only [hψ'def]
        rw [integral_finset_sum _ (fun i _ ↦ (hint1 i k).const_mul (w i))]
        simp_rw [integral_const_mul]
        rw [← hw1]
        refine Finset.sum_congr rfl fun i _ ↦ ?_
        rw [integral_add_right_eq_self (μ := μ) (fun s ↦ ψ (φ i k) s), hψ.integral_eq_one,
          mul_one]
      rw [hne] at h1
      simp at h1
    · rw [tendsto_smallSets_iff]
      intro V hV
      obtain ⟨ε, hε, hεV⟩ := Metric.mem_nhds_iff.1 hV
      have hs : ∀ i, ∀ᶠ k in atTop, support (ψ (φ i k)) ⊆ ball 0 (ε / 2) := fun i ↦
        (hφ i).tendsto_atTop.eventually
          ((tendsto_smallSets_iff.1 hψ.tendsto_support_smallSets) _ (ball_mem_nhds _ (half_pos hε)))
      have hcs : ∀ i, ∀ᶠ k in atTop, ‖c i k‖ < ε / 2 := fun i ↦ by
        have := (hc i).eventually (ball_mem_nhds (0 : E) (half_pos hε))
        simpa only [mem_ball, dist_zero_right] using this
      filter_upwards [eventually_all.2 hs, eventually_all.2 hcs] with k hk hck t ht
      obtain ⟨i, hi⟩ := support_mixedKernel_subset w (fun i ↦ ψ (φ i k)) (fun i ↦ c i k) ht
      have h1 := mem_ball_zero_iff.1 (hk i hi)
      apply hεV
      rw [mem_ball_zero_iff]
      calc ‖t‖ = ‖(t + c i k) - c i k‖ := by rw [add_sub_cancel_right]
        _ ≤ ‖t + c i k‖ + ‖c i k‖ := norm_sub_le _ _
        _ < ε / 2 + ε / 2 := add_lt_add h1 (hck i)
        _ = ε := add_halves ε
  · exact continuous_finset_sum _ fun i _ ↦
      continuous_const.mul ((hcont _).comp (continuous_add_right _))
  · have hg : ∀ k, gradient (mollifiedAverage μ (ψ' k) f) x =
        ∑ i, w i • gradient (mollifiedAverage μ (ψ (φ i k)) f) (z i k) := by
      intro k
      have h := gradient_mollifiedAverage_mixedKernel μ w (ψ := fun i ↦ ψ (φ i k))
        (fun i ↦ hψ.measurable _) (fun i ↦ hψ.nonneg _) (fun i ↦ hψ.bounded _)
        (fun i ↦ ⟨R, hRn _⟩) (fun i ↦ c i k) hf x
      simpa [hcdef] using h
    simp_rw [hg]
    exact tendsto_finset_sum _ fun i _ ↦ (hlim i).const_smul (w i)

/-- Limits of gradients at `x̄` along any bounded mollifier sequence are Clarke subgradients. -/
theorem IsBoundedMollifierSequence.mem_clarkeSubdifferential_of_tendsto [μ.IsAddHaarMeasure]
    (hψ : IsBoundedMollifierSequence ψ μ) (hf : ∀ y, StrictlyContinuousAt f y) {x v : E}
    (hv : Tendsto (fun n ↦ gradient (mollifiedAverage μ (ψ n) f) x) atTop (𝓝 v)) :
    v ∈ clarkeSubdifferential (fun y ↦ (f y : EReal)) x :=
  hψ.mollifierGradientLimits_subset_clarkeSubdifferential hf x
    (mem_mollifierGradientLimits_iff.2 ⟨id, strictMono_id, fun _ ↦ x, tendsto_const_nhds, hv⟩)

/-- Every Clarke subgradient is a limit `∇f^ν(x̄) → v` for some sequence of continuous bounded
mollifiers. -/
theorem exists_continuous_mollifier_tendsto_gradient [μ.IsAddHaarMeasure]
    (hf : ∀ y, StrictlyContinuousAt f y) {x v : E}
    (hv : v ∈ clarkeSubdifferential (fun y ↦ (f y : EReal)) x) :
    ∃ ψ : ℕ → E → ℝ, IsBoundedMollifierSequence ψ μ ∧ (∀ n, Continuous (ψ n)) ∧
      Tendsto (fun n ↦ gradient (mollifiedAverage μ (ψ n) f) x) atTop (𝓝 v) := by
  obtain ⟨hψ₀, hψ₀c⟩ := isBoundedMollifierSequence_standardMollifier (E := E) μ
  have hsc : ERealStrictlyContinuousAt (fun y ↦ (f y : EReal)) x :=
    ⟨by simp, by simpa only [EReal.toReal_coe] using hf x⟩
  rw [clarkeSubdifferential_eq_convexHull_aux hsc,
    ((mollifier_subgradients hψ₀ hψ₀c hf).2.2 x).2.1] at hv
  obtain ⟨ι, _, w, u, hw0, hw1, hu, rfl⟩ := mem_convexHull_iff_exists_fintype.1 hv
  obtain ⟨ψ', hψ', hc', hlim⟩ := hψ₀.exists_mixed_tendsto_gradient hf w hw0 hw1 u hu
  exact ⟨ψ', hψ', hc' hψ₀c, hlim⟩

/-- **Theorem 9.67**, last assertion: `v ∈ ∂̄f(x̄) = con ∂f(x̄)` if and only if
`∇f^ν(x̄) → v` for the averages of some bounded mollifier sequence. -/
theorem mem_clarkeSubdifferential_iff_exists_mollifier [μ.IsAddHaarMeasure]
    (hf : ∀ y, StrictlyContinuousAt f y) {x v : E} :
    v ∈ clarkeSubdifferential (fun y ↦ (f y : EReal)) x ↔
      ∃ ψ : ℕ → E → ℝ, IsBoundedMollifierSequence ψ μ ∧
        Tendsto (fun n ↦ gradient (mollifiedAverage μ (ψ n) f) x) atTop (𝓝 v) := by
  constructor
  · intro hv
    obtain ⟨ψ, hψ, -, hlim⟩ := exists_continuous_mollifier_tendsto_gradient (μ := μ) hf hv
    exact ⟨ψ, hψ, hlim⟩
  · rintro ⟨ψ, hψ, hlim⟩
    exact hψ.mem_clarkeSubdifferential_of_tendsto hf hlim

omit [MeasurableSpace E] [BorelSpace E] in
/-- `con ∂f(x̄) = ∂̄f(x̄)` for strictly continuous `f`, as used in the last assertion of 9.67. -/
theorem convexHull_subdifferential_eq_clarkeSubdifferential_of_forall
    (hf : ∀ y, StrictlyContinuousAt f y) (x : E) :
    convexHull ℝ (subdifferential (fun y ↦ (f y : EReal)) x) =
      clarkeSubdifferential (fun y ↦ (f y : EReal)) x :=
  (clarkeSubdifferential_eq_convexHull_aux
    ⟨by simp, by simpa only [EReal.toReal_coe] using hf x⟩).symm

end RW
