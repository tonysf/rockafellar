# Chapter 14: Measurability in hyperspace terms

Theorem 14.4 of Rockafellar–Wets: a closed-valued mapping `S : T ⇉ E` (`E` finite-dimensional)
is measurable if and only if `dom S` is measurable and `S`, viewed as a single-valued mapping from
`dom S` into the hyperspace `(cl-sets≠∅(E), dl)` of Chapter 4 (`SetMetricModel`), is Borel
measurable.  As in the proof, the Effrös field generated by the hit sets `{C ∣ C ∩ O ≠ ∅}`
coincides with the Borel field of the hyperspace: the hit sets are open (Theorem 4.5(a)), and
`C ↦ dl(C, C₀)` is Effrös-measurable since `dl_ρ(C, C₀)` is a countable supremum of
`|d(x, C) − d(x, C₀)|` and `dl` is a parametric integral of `dl_ρ`.
-/

import RockafellarWets.Chapter14.MeasurableMappings
import RockafellarWets.Chapter4.IntegratedSetDistance
import Mathlib.MeasureTheory.Integral.Prod

open Set Filter Topology Metric MeasureTheory
open scoped ENNReal NNReal

noncomputable section

namespace RW

section MeasurableOfDist

/-- In a separable pseudo-metric space with its Borel σ-field, a map is measurable as soon as its
distances to all points are measurable functions. -/
theorem measurable_of_measurable_dist {α X : Type*} [MeasurableSpace α] [PseudoMetricSpace X]
    [TopologicalSpace.SeparableSpace X] [MeasurableSpace X] [BorelSpace X] {f : α → X}
    (hf : ∀ c, Measurable fun a ↦ dist (f a) c) : Measurable f := by
  rcases isEmpty_or_nonempty X with hX | hX
  · exact measurable_of_subsingleton_codomain f
  refine measurable_of_isOpen fun U hU ↦ ?_
  set D := TopologicalSpace.denseSeq X
  have hD := TopologicalSpace.denseRange_denseSeq X
  have hU' : f ⁻¹' U = ⋃ (i : ℕ) (q : ℚ) (_ : ball (D i) (q : ℝ) ⊆ U),
      {a | dist (f a) (D i) < q} := by
    ext a
    simp only [mem_preimage, mem_iUnion, mem_setOf_eq, exists_prop]
    constructor
    · intro ha
      obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hU _ ha
      obtain ⟨i, hi⟩ := hD.exists_dist_lt (f a) (by linarith : (0 : ℝ) < ε / 3)
      obtain ⟨q, hq1, hq2⟩ := exists_rat_btwn (show dist (f a) (D i) < ε / 2 by linarith)
      refine ⟨i, q, fun y hy ↦ hball ?_, hq1⟩
      rw [mem_ball] at hy ⊢
      calc dist y (f a) ≤ dist y (D i) + dist (f a) (D i) := dist_triangle_right _ _ _
        _ < ε := by linarith
    · rintro ⟨i, q, hsub, hq⟩
      exact hsub (mem_ball.2 hq)
  rw [hU']
  exact MeasurableSet.iUnion fun i ↦ MeasurableSet.iUnion fun q ↦ MeasurableSet.iUnion fun _ ↦
    measurableSet_lt (hf _) measurable_const

end MeasurableOfDist

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]

namespace SetMetricModel

/-- The Borel σ-field `B` of the hyperspace `(cl-sets≠∅(E), dl)`. -/
instance instMeasurableSpace : MeasurableSpace (SetMetricModel E) := borel _

instance instBorelSpace : BorelSpace (SetMetricModel E) := ⟨rfl⟩

/-- The hyperspace point of a nonempty closed set. -/
def ofSet (C : Set E) (hC : IsClosed C) (hne : C.Nonempty) : SetMetricModel E :=
  ⟨⟨C, hC, hne⟩⟩

@[simp]
theorem carrier_ofSet (C : Set E) (hC : IsClosed C) (hne : C.Nonempty) :
    (ofSet C hC hne).carrier = C :=
  rfl

/-- The hit sets `{C ∣ C ∩ O ≠ ∅}`, `O` open, are open in the hyperspace (Theorem 4.5(a)). -/
theorem isOpen_setOf_inter_nonempty {O : Set E} (hO : IsOpen O) :
    IsOpen {C : SetMetricModel E | (C.carrier ∩ O).Nonempty} := by
  rw [← isClosed_compl_iff]
  refine IsSeqClosed.isClosed fun {u} {C} hu hlim ↦ ?_
  rintro ⟨x, hxC, hxO⟩
  have hpk := tendsto_iff_pkConverges.1 hlim
  have hx : x ∈ innerSetLimit (fun n ↦ (u n).carrier) := by
    rw [hpk.inner_eq]
    exact hxC
  obtain ⟨n, hn⟩ := (hx O (hO.mem_nhds hxO)).exists
  exact hu n (by simpa [inter_comm] using hn)

end SetMetricModel

section Theorem144

variable {T : Type*} [MeasurableSpace T]

/-- Measurability of the `ρ`-distances `t ↦ dl_ρ(S(t), C)`: a countable supremum of
`|d(x, S(t)) − d(x, C)|` over a dense subset of `ρ𝔹` (proof of Theorem 14.4). -/
theorem SvMeasurable.measurable_rhoDistance {S : T → Set E} (hS : SvMeasurable S) (C : Set E)
    (ρ : ℝ≥0) : Measurable fun t ↦ rhoDistance ρ (S t) C := by
  have hinf : ∀ x : E, Measurable fun t ↦ infDist x (S t) := fun x ↦
    (hS.measurable_infEDist x).ennreal_toReal
  refine measurable_of_Iic fun c ↦ ?_
  rcases lt_or_ge c 0 with hc | hc
  · have : (fun t ↦ rhoDistance ρ (S t) C) ⁻¹' Iic c = ∅ := by
      ext t
      simp only [mem_preimage, mem_Iic, mem_empty_iff_false, iff_false, not_le]
      exact hc.trans_le (rhoDistance_nonneg _ _ _)
    rw [this]
    exact MeasurableSet.empty
  haveI : Nonempty (closedBall (0 : E) (ρ : ℝ)) := ⟨⟨0, mem_closedBall_self ρ.2⟩⟩
  set D := TopologicalSpace.denseSeq (closedBall (0 : E) (ρ : ℝ))
  have hD := TopologicalSpace.denseRange_denseSeq (closedBall (0 : E) (ρ : ℝ))
  have heq : (fun t ↦ rhoDistance ρ (S t) C) ⁻¹' Iic c =
      ⋂ n, {t | dist (infDist (D n : E) (S t)) (infDist (D n : E) C) ≤ c} := by
    ext t
    simp only [mem_preimage, mem_Iic, mem_iInter, mem_setOf_eq, rhoDistance]
    rw [ContinuousMap.dist_le hc]
    constructor
    · intro h n
      exact h (D n)
    · intro h x
      have hcl : IsClosed {y : closedBall (0 : E) (ρ : ℝ) |
          dist (distanceProfile ρ (S t) y) (distanceProfile ρ C y) ≤ c} :=
        isClosed_le ((distanceProfile ρ (S t)).continuous.dist
          (distanceProfile ρ C).continuous) continuous_const
      have hsub : range D ⊆ {y : closedBall (0 : E) (ρ : ℝ) |
          dist (distanceProfile ρ (S t) y) (distanceProfile ρ C y) ≤ c} := by
        rintro _ ⟨n, rfl⟩
        exact h n
      have h' := hcl.closure_subset_iff.2 hsub
      rw [hD.closure_range] at h'
      exact h' (mem_univ x)
  rw [heq]
  exact MeasurableSet.iInter fun n ↦ measurableSet_le ((hinf _).dist measurable_const)
    measurable_const

/-- Measurability of `t ↦ dl(S(t), C)` for the integrated set distance `dl` of 4(12). -/
theorem SvMeasurable.measurable_integratedSetDistance {S : T → Set E} (hS : SvMeasurable S)
    (C : Set E) : Measurable fun t ↦ integratedSetDistance (S t) C := by
  have hjoint : Measurable (Function.uncurry fun (ρ : ℝ) (t : T) ↦
      rhoDistanceReal ρ (S t) C * Real.exp (-ρ)) :=
    measurable_uncurry_of_continuous_of_measurable
      (fun t ↦ (continuous_rhoDistanceReal (S t) C).mul (Real.continuous_exp.comp continuous_neg))
      (fun ρ ↦ (hS.measurable_rhoDistance C ρ.toNNReal).mul_const _)
  have hswap : StronglyMeasurable (Function.uncurry fun (t : T) (ρ : ℝ) ↦
      rhoDistanceReal ρ (S t) C * Real.exp (-ρ)) :=
    (hjoint.comp measurable_swap).stronglyMeasurable
  exact (hswap.integral_prod_right (ν := volume.restrict (Ioi (0 : ℝ)))).measurable

/-- **Theorem 14.4 (measurability in hyperspace terms).** A closed-valued `S : T ⇉ E` is
measurable if and only if `dom S` is measurable and `S`, viewed as a single-valued mapping from
`dom S` to the hyperspace `(cl-sets≠∅(E), dl)` with its Borel field, is measurable. -/
theorem measurability_in_hyperspace_terms {S : T → Set E} (hSc : ∀ t, IsClosed (S t)) :
    SvMeasurable S ↔ MeasurableSet (svDom S) ∧
      Measurable fun t : svDom S ↦ SetMetricModel.ofSet (S t) (hSc t) t.2 := by
  constructor
  · intro hS
    refine ⟨hS.measurableSet_svDom, measurable_of_measurable_dist fun c ↦ ?_⟩
    simp only [SetMetricModel.dist_eq, SetMetricModel.carrier_ofSet]
    exact (hS.measurable_integratedSetDistance c.carrier).comp measurable_subtype_coe
  · rintro ⟨hdom, hs⟩ O hO
    have heq : svPreimage S O = Subtype.val '' ((fun t : svDom S ↦
        SetMetricModel.ofSet (S t) (hSc t) t.2) ⁻¹' {C | (C.carrier ∩ O).Nonempty}) := by
      ext t
      simp only [svPreimage, mem_setOf_eq, mem_image, mem_preimage,
        SetMetricModel.carrier_ofSet, Subtype.exists, exists_and_right, exists_eq_right]
      constructor
      · intro h
        exact ⟨h.mono inter_subset_left, h⟩
      · rintro ⟨_, h⟩
        exact h
    rw [heq]
    exact hdom.subtype_image (hs (SetMetricModel.isOpen_setOf_inter_nonempty hO).measurableSet)

/-- The Effrös field of the hyperspace, generated by the hit sets `{C ∣ C ∩ O ≠ ∅}` with `O` open,
is its Borel field (proof of Theorem 14.4). -/
theorem SetMetricModel.borel_eq_effros :
    borel (SetMetricModel E) = MeasurableSpace.generateFrom
      {A | ∃ O : Set E, IsOpen O ∧ A = {C : SetMetricModel E | (C.carrier ∩ O).Nonempty}} := by
  set G := {A | ∃ O : Set E, IsOpen O ∧ A = {C : SetMetricModel E | (C.carrier ∩ O).Nonempty}}
  refine le_antisymm ?_ (MeasurableSpace.generateFrom_le ?_)
  · have hcar : @SvMeasurable (SetMetricModel E) E (MeasurableSpace.generateFrom G) _
        (fun C : SetMetricModel E ↦ C.carrier) := fun O hO ↦
      MeasurableSpace.measurableSet_generateFrom ⟨O, hO, by
        ext C
        simp [svPreimage]⟩
    have hid : @Measurable (SetMetricModel E) (SetMetricModel E) (MeasurableSpace.generateFrom G)
        SetMetricModel.instMeasurableSpace id :=
      @measurable_of_measurable_dist _ _ (MeasurableSpace.generateFrom G) _ _ _ _ id fun c ↦
        @SvMeasurable.measurable_integratedSetDistance E _ _ _ _ (MeasurableSpace.generateFrom G)
          _ hcar c.carrier
    have h := hid.comap_le
    rwa [MeasurableSpace.comap_id] at h
  · rintro _ ⟨O, hO, rfl⟩
    exact (SetMetricModel.isOpen_setOf_inter_nonempty hO).measurableSet

end Theorem144

end RW
