# Chapter 10: normals for Lipschitzian constraints

**Corollary 10.50** for `C = F⁻¹(D)` with `D ⊂ ℝᵐ` closed and `F` strictly continuous at a point
`x̄ ∈ C`, writing `∂(yF)(x̄)` for the subgradients of `x ↦ ⟪y, F(x)⟫`:

* `N̂_C(x̄) ⊃ ⋃ {∂̂(yF)(x̄) | y ∈ N̂_D(F(x̄))}` (`regularNormalCone_preimage_superset`);
* if the only `y ∈ N_D(F(x̄))` with `0 ∈ ∂(yF)(x̄)` is `y = 0`, then
  `N_C(x̄) ⊂ K(x̄) := ⋃ {∂(yF)(x̄) | y ∈ N_D(F(x̄))}` (`normalCone_preimage_subset`);
* if in addition `D` is regular at `F(x̄)` and `yF` is regular at `x̄` for every `y ∈ N_D(F(x̄))`,
  then `C` is regular at `x̄` and `N_C(x̄) = K(x̄)` (`preimage_regular_of_strictlyContinuous`).

As in the book, these are 10.49 (`ExtendedChainRule`) with `g = δ_D`, since `δ_D ∘ F = δ_C` and
`∂̂δ_D = N̂_D`, `∂δ_D = ∂^∞δ_D = N_D` (8.14).  For `g = δ_D` the regularity hypothesis of the
formal 10.49 (on the cone generated by `∂g` and on `∂^∞g`) is exactly regularity of `yF` for
`y ∈ N_D(F(x̄))`, so the regular case is stated as printed.  The outer semicontinuity of
`x ↦ K(x)` is `constraintNormalEstimate_osc` in `LipschitzConstraintNormalsOsc`.

The parenthetical strictly differentiable cases of 10.49 and 10.50 are
`comp_regular_of_hasStrictFDerivAt` and `preimage_regular_of_hasStrictFDerivAt`: then every
`yF` is regular at `x̄` (9.18), and only the qualification remains.
-/

import RockafellarWets.Chapter10.ExtendedChainRule
import RockafellarWets.Chapter8.IndicatorSubgradients
import RockafellarWets.Chapter9.SingleValuedStrictDifferentiability

open Filter Function Metric Set Topology
open scoped NNReal ENNReal InnerProductSpace Pointwise

namespace RW

variable {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
  [NormedAddCommGroup F] [InnerProductSpace ℝ F] [FiniteDimensional ℝ F]

omit [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
  [NormedAddCommGroup F] [InnerProductSpace ℝ F] [FiniteDimensional ℝ F] in
/-- `δ_D ∘ F = δ_{F⁻¹(D)}`. -/
theorem indicatorVA_comp_eq (D : Set F) (G : E → F) :
    (fun a ↦ indicatorVA D (G a)) = indicatorVA (G ⁻¹' D) := rfl

omit [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
  [NormedAddCommGroup F] [InnerProductSpace ℝ F] [FiniteDimensional ℝ F] in
theorem indicatorVA_eq_zero_of_mem {D : Set F} {u : F} (hu : u ∈ D) :
    indicatorVA D u = ((0 : ℝ) : EReal) := by
  simp [indicatorVA, hu]

/-- **Corollary 10.50**: `N̂_C(x̄) ⊃ ⋃ {∂̂(yF)(x̄) | y ∈ N̂_D(F(x̄))}` for `C = F⁻¹(D)`. -/
theorem regularNormalCone_preimage_superset {D : Set F} {G : E → F} {x : E}
    (hG : StrictlyContinuousAt G x) (hx : G x ∈ D) :
    {v | ∃ y ∈ regularNormalCone D (G x),
        v ∈ regularSubdifferential (fun a ↦ ((⟪y, G a⟫_ℝ : ℝ) : EReal)) x} ⊆
      regularNormalCone (G ⁻¹' D) x := by
  have h := regularSubdifferential_comp_superset (g := indicatorVA D) hG
    (indicatorVA_eq_zero_of_mem hx)
  rw [regularSubdifferential_indicatorVA, indicatorVA_comp_eq,
    regularSubdifferential_indicatorVA] at h
  exact h

/-- **Corollary 10.50**: if the only `y ∈ N_D(F(x̄))` with `0 ∈ ∂(yF)(x̄)` is `y = 0`, then
`N_C(x̄) ⊂ ⋃ {∂(yF)(x̄) | y ∈ N_D(F(x̄))}` for `C = F⁻¹(D)`. -/
theorem normalCone_preimage_subset {D : Set F} {G : E → F} {x : E} (hD : IsClosed D)
    (hG : StrictlyContinuousAt G x) (hx : G x ∈ D)
    (hQ : ∀ y ∈ normalCone D (G x),
      (0 : E) ∈ subdifferential (fun a ↦ ((⟪y, G a⟫_ℝ : ℝ) : EReal)) x → y = 0) :
    normalCone (G ⁻¹' D) x ⊆
      {v | ∃ y ∈ normalCone D (G x),
        v ∈ subdifferential (fun a ↦ ((⟪y, G a⟫_ℝ : ℝ) : EReal)) x} := by
  have h := (subdifferential_comp_subset_of_strictlyContinuous (g := indicatorVA D)
    (lowerSemicontinuous_indicatorVA hD) hG (indicatorVA_eq_zero_of_mem hx)
    (by rw [horizonSubdifferential_indicatorVA]; exact hQ)).1
  rw [subdifferential_indicatorVA, indicatorVA_comp_eq, subdifferential_indicatorVA] at h
  exact h

/-- **Corollary 10.50**, regular case: if moreover `D` is regular at `F(x̄)` and `yF` is regular
at `x̄` for every `y ∈ N_D(F(x̄))`, then `C = F⁻¹(D)` is regular at `x̄` and
`N_C(x̄) = ⋃ {∂(yF)(x̄) | y ∈ N_D(F(x̄))}`. -/
theorem preimage_regular_of_strictlyContinuous {D : Set F} {G : E → F} {x : E}
    (hD : IsClosed D) (hG : StrictlyContinuousAt G x) (hx : G x ∈ D)
    (hQ : ∀ y ∈ normalCone D (G x),
      (0 : E) ∈ subdifferential (fun a ↦ ((⟪y, G a⟫_ℝ : ℝ) : EReal)) x → y = 0)
    (hrD : IsClarkeRegularAt D (G x))
    (hry : ∀ y ∈ normalCone D (G x),
      IsSubdifferentiallyRegularAt (fun a ↦ ((⟪y, G a⟫_ℝ : ℝ) : EReal)) x) :
    IsClarkeRegularAt (G ⁻¹' D) x ∧
      normalCone (G ⁻¹' D) x =
        {v | ∃ y ∈ normalCone D (G x),
          v ∈ subdifferential (fun a ↦ ((⟪y, G a⟫_ℝ : ℝ) : EReal)) x} := by
  have hcone := isCone_normalCone hx
  have h := comp_regular_of_strictlyContinuous (g := indicatorVA D)
    (lowerSemicontinuous_indicatorVA hD) hG (indicatorVA_eq_zero_of_mem hx)
    (by rw [horizonSubdifferential_indicatorVA]; exact hQ)
    ((isSubdifferentiallyRegularAt_indicatorVA_iff hx).2 hrD) (by
      rintro y (⟨r, hr, hy⟩ | hy)
      · rw [subdifferential_indicatorVA] at hy
        obtain ⟨w, hw, rfl⟩ := mem_smul_set.1 hy
        exact hry _ (hcone.2 hw hr)
      · rw [horizonSubdifferential_indicatorVA] at hy
        exact hry y hy)
  obtain ⟨hreg, heq, -⟩ := h
  rw [indicatorVA_comp_eq] at hreg heq
  rw [subdifferential_indicatorVA, subdifferential_indicatorVA] at heq
  exact ⟨(isSubdifferentiallyRegularAt_indicatorVA_iff (C := G ⁻¹' D) hx).1 hreg, heq⟩

/-- When `F` is strictly differentiable at `x̄`, every scalarization `yF` is regular at `x̄`
(9.18); this is the parenthetical case of 10.49 and 10.50. -/
theorem isSubdifferentiallyRegularAt_inner_of_hasStrictFDerivAt {G : E → F} {L : E →L[ℝ] F}
    {x : E} (h : HasStrictFDerivAt G L x) (y : F) :
    IsSubdifferentiallyRegularAt (fun a ↦ ((⟪y, G a⟫_ℝ : ℝ) : EReal)) x :=
  (hasStrictGradientAt_inner_of_hasStrictFDerivAt h y).isSubdifferentiallyRegularAt

omit [FiniteDimensional ℝ E] [FiniteDimensional ℝ F] in
/-- A mapping strictly differentiable at `x̄` is strictly continuous at `x̄`. -/
theorem strictlyContinuousAt_of_hasStrictFDerivAt {G : E → F} {L : E →L[ℝ] F} {x : E}
    (h : HasStrictFDerivAt G L x) : StrictlyContinuousAt G x :=
  strictlyContinuousAt_iff.2 h.exists_lipschitzOnWith

/-- **Theorem 10.49**, regular case for `F` strictly differentiable at `x̄`: if `g` is regular at
`F(x̄)` and the qualification holds, then `f = g ∘ F` is regular at `x̄` with
`∂f(x̄) = ⋃ {∂(yF)(x̄) | y ∈ ∂g(F(x̄))}` and `∂^∞f(x̄) = ⋃ {∂(yF)(x̄) | y ∈ ∂^∞g(F(x̄))}`. -/
theorem comp_regular_of_hasStrictFDerivAt {g : F → EReal} {G : E → F} {L : E →L[ℝ] F} {x : E}
    {c : ℝ} (hl : LowerSemicontinuous g) (hG : HasStrictFDerivAt G L x) (hc : g (G x) = c)
    (hQ : ∀ y ∈ horizonSubdifferential g (G x),
      (0 : E) ∈ subdifferential (fun a ↦ ((⟪y, G a⟫_ℝ : ℝ) : EReal)) x → y = 0)
    (hrg : IsSubdifferentiallyRegularAt g (G x)) :
    IsSubdifferentiallyRegularAt (fun a ↦ g (G a)) x ∧
      subdifferential (fun a ↦ g (G a)) x =
        {v | ∃ y ∈ subdifferential g (G x),
          v ∈ subdifferential (fun a ↦ ((⟪y, G a⟫_ℝ : ℝ) : EReal)) x} ∧
      horizonSubdifferential (fun a ↦ g (G a)) x =
        {v | ∃ y ∈ horizonSubdifferential g (G x),
          v ∈ subdifferential (fun a ↦ ((⟪y, G a⟫_ℝ : ℝ) : EReal)) x} :=
  comp_regular_of_strictlyContinuous hl (strictlyContinuousAt_of_hasStrictFDerivAt hG) hc hQ hrg
    (fun y _ ↦ isSubdifferentiallyRegularAt_inner_of_hasStrictFDerivAt hG y)

/-- **Corollary 10.50**, regular case for `F` strictly differentiable at `x̄`. -/
theorem preimage_regular_of_hasStrictFDerivAt {D : Set F} {G : E → F} {L : E →L[ℝ] F} {x : E}
    (hD : IsClosed D) (hG : HasStrictFDerivAt G L x) (hx : G x ∈ D)
    (hQ : ∀ y ∈ normalCone D (G x),
      (0 : E) ∈ subdifferential (fun a ↦ ((⟪y, G a⟫_ℝ : ℝ) : EReal)) x → y = 0)
    (hrD : IsClarkeRegularAt D (G x)) :
    IsClarkeRegularAt (G ⁻¹' D) x ∧
      normalCone (G ⁻¹' D) x =
        {v | ∃ y ∈ normalCone D (G x),
          v ∈ subdifferential (fun a ↦ ((⟪y, G a⟫_ℝ : ℝ) : EReal)) x} :=
  preimage_regular_of_strictlyContinuous hD (strictlyContinuousAt_of_hasStrictFDerivAt hG) hx hQ hrD
    (fun y _ ↦ isSubdifferentiallyRegularAt_inner_of_hasStrictFDerivAt hG y)

end RW
